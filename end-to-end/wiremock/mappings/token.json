{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "basicAuthCredentials": {
      "username": "httpyac-e2e-client",
      "password": "httpyac-e2e-secret"
    },
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "formParameters": {
      "grant_type": {
        "equalTo": "client_credentials"
      },
      "scope": {
        "equalTo": "api.read"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      "Pragma": "no-cache"
    },
    "bodyFileName": "token.json"
  }
}
